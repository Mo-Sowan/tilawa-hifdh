{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MushafCache": {
    "DirectoryPath": "Storage/MushafCache",
    "UpstreamRoot": "https://archive.org/download/qalooon-jam",
    "MaxConcurrentDownloads": 4,
    "DownloadTimeoutSeconds": 90,
    "MaxDownloadMegabytes": 20,
    "MaxImageMegapixels": 40,
    "UseWebP": true,
    "WebPQuality": 90,
    "PrewarmEnabled": false,
    "PrewarmParallelism": 2,
    "PrewarmDelayMilliseconds": 1000
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "QueueLimit": 20
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "tilawa-api",
    "Audience": "tilawa-app",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 60
  },
  "Auth": {
    "Google": {
      "ClientIds": []
    },
    "Apple": {
      "ClientIds": [],
      "Issuer": "https://appleid.apple.com",
      "MetadataAddress": "https://appleid.apple.com/.well-known/openid-configuration"
    }
  }
}
